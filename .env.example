# =============================================================================
# App environment (copy to .env.local — never commit .env.local)
# =============================================================================

# Cloudflare Worker URL (auth + backup API).
# Example: https://classroom-cloud-backup.<account>.workers.dev
NEXT_PUBLIC_CLOUD_BACKUP_URL=

# Google OAuth client IDs (public — no client secret in the app).
# Web dev (`npm run dev`): Web application client + Authorized JavaScript origins.
# Tauri desktop (.exe): Desktop app client (PKCE loopback).
# Required for production builds; embedded at Next build time.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID_DESKTOP=

# After changing any NEXT_PUBLIC_* value, rebuild: npm run tauri:build

# Ed25519 public key (SPKI PEM) — must match Worker ENTITLEMENT_PRIVATE_KEY pair.
# Multi-line PEM in quotes is supported:
# NEXT_PUBLIC_ENTITLEMENT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----"
NEXT_PUBLIC_ENTITLEMENT_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Removed (legacy device backup — do not use)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_CLOUD_BACKUP_TOKEN=
# CLOUD_BACKUP_TOKEN=
