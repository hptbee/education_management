# Optional Cloudflare Worker URL for classroom backup (opt-in per class in Settings → Dữ liệu).
# Leave empty to disable cloud backup entirely.
NEXT_PUBLIC_CLOUD_BACKUP_URL=

# Bearer token for backup upload — must match BACKUP_API_TOKEN on the Worker.
# Web/dev: NEXT_PUBLIC_CLOUD_BACKUP_TOKEN (bundled; use only for local testing).
# Tauri desktop: set CLOUD_BACKUP_TOKEN in the environment (not bundled in the client).
NEXT_PUBLIC_CLOUD_BACKUP_TOKEN=
